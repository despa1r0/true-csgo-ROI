# Ключ из CSFloat: Profile -> Developer. Используется только backend-ом.
CSFLOAT_API_KEY=

# Цена/лот хранятся в PostgreSQL столько секунд, чтобы беречь лимит CSFloat API.
CSFLOAT_CACHE_TTL_SECONDS=300

# Подробные листинги и история продаж кэшируются отдельно.
CSFLOAT_DETAILS_TTL_SECONDS=600

# Partner Token из профиля white.market (выдаётся не самообслуживанием —
# нужно запросить у поддержки WhiteMarket). Обязателен: все данные WhiteMarket
# (и минимальная цена, и листинги) идут только через Partner GraphQL API.
WHITEMARKET_PARTNER_TOKEN=

# Цена по каждому варианту скина кэшируется в PostgreSQL столько секунд.
WHITEMARKET_CACHE_TTL_SECONDS=300

# Ключ Market.CSGO. Никогда не передаётся во frontend и не выводится в ответах API.
CSGOMARKET_API_KEY=

# Консервативный лимит приватных запросов: 30 в минуту.
CSGOMARKET_MAX_REQUESTS_PER_SECOND=0.5

# Общий индекс цен и подробная аналитика используют раздельный PostgreSQL-кэш.
CSGOMARKET_CACHE_TTL_SECONDS=300
CSGOMARKET_DETAILS_TTL_SECONDS=600

# Публичный индекс истории продаж обновляется площадкой примерно раз в час.
CSGOMARKET_HISTORY_INDEX_TTL_SECONDS=3600

# Английские market_hash_name используются для точного поиска на площадках.
CATALOG_SOURCE_URL=https://raw.githubusercontent.com/ByMykel/CSGO-API/main/public/api/en/skins_not_grouped.json

# Сгруппированный источник содержит связи с коллекциями.
CATALOG_GROUPED_SOURCE_URL=https://raw.githubusercontent.com/ByMykel/CSGO-API/main/public/api/en/skins.json

# Базовый адрес остальных категорий: cases, stickers, charms, agents и т.д.
CATALOG_EXTRA_SOURCE_BASE_URL=https://raw.githubusercontent.com/ByMykel/CSGO-API/main/public/api/en

POSTGRES_DB=true_roi
POSTGRES_USER=true_roi
POSTGRES_PASSWORD=yourpassword
DATABASE_URL=postgresql://${POSTGRES_DB}:${POSTGRESS_PASSWORD}@db:5432/${POSTGRES_USER}
