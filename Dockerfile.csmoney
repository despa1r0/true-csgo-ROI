FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

COPY backend/requirements.txt backend/requirements-csmoney.txt /app/backend/
RUN pip install --no-cache-dir -r /app/backend/requirements-csmoney.txt \
    && python -m playwright install-deps firefox \
    && python -m camoufox fetch

COPY backend /app/backend

CMD ["python", "-m", "backend.app.csmoney_worker"]
