FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

# Runtime libraries the bundled (Camoufox) Firefox build needs to launch,
# even headless. Mirrors Playwright's Firefox dependency list for Debian.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgtk-3-0t64 \
    libx11-xcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxrender1 \
    libxtst6 \
    libnss3 \
    libcups2t64 \
    libxss1 \
    libxrandr2 \
    libasound2t64 \
    libpangocairo-1.0-0 \
    libatk1.0-0 \
    libatk-bridge2.0-0t64 \
    libgdk-pixbuf-2.0-0 \
    libdbus-glib-1-2 \
    libxt6t64 \
    fonts-liberation \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements-worker.txt /app/backend/requirements-worker.txt
COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir -r /app/backend/requirements-worker.txt
RUN python -m camoufox fetch

COPY backend /app/backend

CMD ["python", "-m", "backend.app.csmoney_worker"]
